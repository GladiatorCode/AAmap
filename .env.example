# Copy this file to .env.local and fill in your own secrets.
# Never commit .env.local — it stays on the server only.

# Shared password moderators type in the Login dialog.
MODERATOR_CODE=change-me-to-a-long-secret-phrase

# Random string used to sign the login cookie (not the login code itself).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
